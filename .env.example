# ── Frontend (Vite) ─────────────────────────────────────────────
# Projeto Supabase PRÓPRIO do Leadrix CRM. Sem estas duas variáveis o app roda
# em modo demonstração (dados fictícios no navegador).
# Projetos novos usam a chave publishable (sb_publishable_...) — ver Guia §9.1.
VITE_SUPABASE_URL=https://SEU-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Importador / scripts (Node, chave secreta — NUNCA expor no front) ──
SUPABASE_URL=https://SEU-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
BASE_XLSX_PATH=

# ── Handoff para um sistema de projetos (opcional, dormente) ────
# Deixe vazio enquanto a Leadrix não tiver um sistema de projetos que receba o
# fechamento. Usado pelas Edge Functions crm-handoff / crm-cancel / catalog.
OPERACIONAL_ONBOARDING_URL=
OPERACIONAL_CANCEL_URL=
OPERACIONAL_CATALOG_URL=
CRM_WEBHOOK_SECRET=

# ── IA (co-piloto ABM e estúdio de conteúdo) — só nas Edge Functions ──
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# ── Mensageria (Gmail da Leadrix) — só nas Edge Functions ───────
# Cliente OAuth do Google Cloud com o escopo gmail.send e um refresh token da
# caixa que envia. O alias remetente precisa estar verificado no Gmail
# (Configurações → Contas → "Enviar e-mail como").
GMAIL_SENDER=marcelo@leadrix.com.br
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
